# إعدادات تيليجرام
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_ID=your_admin_id_here

# إعدادات الأزواج
PAIR_1=BTC/USDT
PAIR_2=ETH/USDT
PAIR_3=SOL/USDT
ACTIVE_PAIR=BTC/USDT

# إعدادات التحليل
TIMEFRAME=5m
TRADE_DURATION=60
MONITOR_INTERVAL=10
SIGNAL_MODE=MANUAL  # MANUAL | AUTO | OFF

# إعدادات الذكاء الاصطناعي
AI_PROVIDER=openai  # openai | groq | gemini
OPENAI_API_KEY=your_openai_key
AI_MODEL=gpt-3.5-turbo

# إعدادات Render
PORT=10000
NODE_ENV=production
